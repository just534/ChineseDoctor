# 复制为 .env 后修改
DB_PASSWORD=请改成强密码
# 生成方式：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=请改成至少32位的随机字符串

# 初始超级管理员（仅首次启动时创建；留空则随机生成密码并打印在 backend 日志中，首次登录需修改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# 是否开放前台注册
ALLOW_REGISTRATION=true

# AI 经方问诊（可选，不填则前台显示“未开通”）
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_LIMIT=30

HTTP_PORT=80
WEB_CONCURRENCY=2
